# Copia este archivo como .env y ajusta los valores según tu máquina.
# .env nunca se sube al repositorio (ver .gitignore).

# Puerto donde escucha el servidor Express
PORT=3001

# Puerto serial donde está conectado el Arduino (revisa el Administrador de dispositivos en Windows,
# o "ls /dev/tty.*" en Mac/Linux). Cada integrante del equipo puede tener uno distinto.
ARDUINO_PORT=COM4

# Velocidad del puerto serial (debe coincidir con el Serial.begin() del sketch de Arduino)
ARDUINO_BAUD_RATE=9600
